NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb+srv://usuario:password@cluster/database
# Postgres (Neon) — opcional. Si falta, la API funciona solo con MongoDB.
DATABASE_URL=postgresql://usuario:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full

JWT_SECRET=reemplazar-por-un-secreto-de-al-menos-32-caracteres
JWT_EXPIRES_IN=7d
PENDING_REGISTRATION_SECRET=reemplazar-por-un-secreto-de-al-menos-32-caracteres
ACCEPTED_TERMS_VERSION=2026-08

FRONTEND_URL=http://localhost:5173

# Usar "test" en desarrollo y "production" únicamente con credenciales reales.
MP_ENV=test
MP_ACCESS_TOKEN=reemplazar-por-el-access-token-de-mercado-pago
MP_WEBHOOK_URL=https://backend-publico.example.com/api/payments/webhook
MP_WEBHOOK_SECRET=reemplazar-por-la-clave-secreta-del-webhook

CLOUDINARY_CLOUD_NAME=reemplazar
CLOUDINARY_API_KEY=reemplazar
CLOUDINARY_API_SECRET=reemplazar

# Envío de códigos de confirmación (baja / arrepentimiento). Gmail SMTP:
# generar una "Contraseña de aplicación" en la cuenta (requiere verificación
# en 2 pasos activada) — nunca usar la contraseña normal de la cuenta acá.
SMTP_USER=reemplazar-por-el-gmail-de-soporte
SMTP_PASS=reemplazar-por-la-contraseña-de-aplicacion

# Notificaciones push para admins (Firebase Cloud Messaging) — opcional. Si
# falta, la API funciona igual y no se mandan push. Es el JSON de la cuenta de
# servicio (Firebase Console → Configuración del proyecto → Cuentas de
# servicio → Generar nueva clave privada), pegado tal cual o en base64.
FIREBASE_SERVICE_ACCOUNT=

# Pagos de pedidos (take away / delivery) con la cuenta de Mercado Pago de cada
# local — OPCIONAL. Es una aplicación de MP APARTE de la de las suscripciones
# (otro client_id/secret y otro secret de webhook). Si faltan, la API funciona
# igual y solo estos pagos responden "no disponible".
MP_ORDERS_CLIENT_ID=
MP_ORDERS_CLIENT_SECRET=
# Registrar en "URLs de redireccionamiento" de la app:
MP_ORDERS_REDIRECT_URI=https://backend-publico.example.com/api/orders/payments/oauth/callback
# Webhook de la app de pedidos (evento Pagos):
MP_ORDERS_WEBHOOK_URL=https://backend-publico.example.com/api/orders/payments/webhook
MP_ORDERS_WEBHOOK_SECRET=
# Clave propia (>= 32 caracteres) para cifrar los tokens de MP de los locales.
# Si se cambia, los locales tienen que volver a conectar su cuenta.
ORDERS_CREDENTIALS_KEY=
